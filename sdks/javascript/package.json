{
  "name": "@downloader/client",
  "version": "0.8.5",
  "description": "Zero-dependency typed JavaScript and TypeScript client for the REST API Downloader service.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
